GOOGLE_LOCATION_API_KEY=

# Django
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=apps.settings
# Production toggles
DEBUG=false
# Wymagane gdy DEBUG=false (lista po przecinku), np. example.com,www.example.com
ALLOWED_HOSTS=
# Lista po przecinku, np. https://example.com
CSRF_TRUSTED_ORIGINS=

# ===== Database (PostgreSQL) =====
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Logowanie / OAuth / szyfrowanie =====
# Dane klienta OAuth z Google Cloud Console (typ "Web application").
# To jest glowne zrodlo - plik settings/credentials.json to tylko fallback dla dev,
# bo katalog /settings jest w .dockerignore i nie trafia do obrazu.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Np. https://geoleadsmailer.work.gd - uzywane do budowy redirect_uri.
PUBLIC_BASE_URL=

# Klucz podpisujacy JWT. Osobny od DJANGO_SECRET_KEY: jego rotacja wylogowuje
# wszystkich, nie ruszajac sesji ani tokenow resetu hasla.
# Generowanie: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=

# Klucze Fernet do szyfrowania tokenow Google w bazie. Lista po przecinku,
# NAJNOWSZY PIERWSZY - szyfrowanie idzie pierwszym, odszyfrowanie dowolnym,
# wiec rotacja to: dopisz nowy na poczatek -> deploy -> przeszyfruj -> usun stary.
# MUSI byc ustawione PRZED `manage.py migrate` (migracja danych szyfruje tokeny).
# Generowanie: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# false tylko dla lokalnego HTTP; w produkcji musi byc true (pilnuje tego manage.py check)
COOKIE_SECURE=true

# ===== Celery brokers =====
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
REDIS_BROKER_URL=redis://redis:6379/0
# Cache Django - db 1, bo db 0 jest zajete przez brokera Celery powyzej.
REDIS_CACHE_URL=redis://redis:6379/1

# ===== Opcjonalne (maja sensowne domyslne wartosci) =====
# CREDENTIALS_FILE=settings/credentials.json
# EMAIL_ATTACHMENTS_DIR=uploads/email_attachments
# DJANGO_LOG_LEVEL=INFO
