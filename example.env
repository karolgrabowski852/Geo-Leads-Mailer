# Django
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=apps.settings
# Production toggles
DEBUG=false
# Wymagane gdy DEBUG=false (lista po przecinku), np. example.com,www.example.com
ALLOWED_HOSTS=
# Lista po przecinku, np. https://example.com
CSRF_TRUSTED_ORIGINS=

# ===== Database (PostgreSQL) =====
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Logowanie / OAuth / szyfrowanie =====
# Wspolny klient OAuth typu "Web application" z Google Cloud Console.
# Uzytkownicy autoryzuja swoje konta Google; nie przesylaja plikow credentials JSON.
# Secret przechowuj w sekrecie wdrozenia, nie w repozytorium.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Np. https://geoleadsmailer.work.gd - uzywane do budowy redirect_uri.
PUBLIC_BASE_URL=

# Klucz podpisujacy JWT. Osobny od DJANGO_SECRET_KEY: jego rotacja wylogowuje
# wszystkich, nie ruszajac sesji ani tokenow resetu hasla.
# Generowanie: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=

# Stabilne klucze salt dla django-fernet-encrypted-fields. Lista po przecinku;
# pierwszy sluzy do nowych zapisow, wszystkie do odczytu. Przechowuj poza baza.
# Generowanie: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_SALT_KEYS=

# false tylko dla lokalnego HTTP; w produkcji musi byc true (pilnuje tego manage.py check)
COOKIE_SECURE=true

# ===== Celery brokers =====
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
REDIS_BROKER_URL=redis://redis:6379/0
# Cache Django - db 1, bo db 0 jest zajete przez brokera Celery powyzej.
REDIS_CACHE_URL=redis://redis:6379/1

# ===== Opcjonalne (maja sensowne domyslne wartosci) =====
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# OVERPASS_API_FALLBACK_URLS=https://overpass.openstreetmap.fr/api/interpreter,https://overpass.private.coffee/api/interpreter
# OVERPASS_USER_AGENT=GeoLeadsMailer/1.0
# EMAIL_ATTACHMENTS_DIR=uploads/email_attachments
# DJANGO_LOG_LEVEL=INFO
